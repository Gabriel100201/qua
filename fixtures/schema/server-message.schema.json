{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qua.local/schema/server-message.schema.json",
  "$ref": "#/$defs/ServerMessage",
  "$defs": {
    "ServerMessage": {
      "oneOf": [
        {
          "$ref": "#/$defs/HelloOkMessage"
        },
        {
          "$ref": "#/$defs/AckMessage"
        },
        {
          "$ref": "#/$defs/TranscriptPartialMessage"
        },
        {
          "$ref": "#/$defs/CaptureRequestMessage"
        },
        {
          "$ref": "#/$defs/SessionDoneMessage"
        },
        {
          "$ref": "#/$defs/ErrorMessage"
        }
      ],
      "title": "ServerMessage"
    },
    "HelloOkMessage": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "hello.ok"
        },
        "daemon_version": {
          "type": "string"
        },
        "session_dir": {
          "type": "string"
        }
      },
      "required": [
        "v",
        "type",
        "daemon_version",
        "session_dir"
      ],
      "additionalProperties": false
    },
    "AckMessage": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "ack"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "v",
        "type",
        "seq"
      ],
      "additionalProperties": false
    },
    "TranscriptPartialMessage": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "transcript.partial"
        },
        "utterance": {
          "$ref": "#/$defs/Utterance"
        }
      },
      "required": [
        "v",
        "type",
        "utterance"
      ],
      "additionalProperties": false
    },
    "Utterance": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^u\\d{2,}$"
        },
        "t_start": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "t_end": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string"
        },
        "lang": {
          "type": "string",
          "minLength": 2
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Word"
          }
        },
        "avg_logprob": {
          "type": "number"
        },
        "no_speech_prob": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "marked": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "t_start",
        "t_end",
        "text",
        "lang",
        "words",
        "avg_logprob",
        "no_speech_prob",
        "marked"
      ],
      "additionalProperties": false,
      "title": "Utterance"
    },
    "Word": {
      "type": "object",
      "properties": {
        "w": {
          "type": "string"
        },
        "t": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "d": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "w",
        "t",
        "d",
        "p"
      ],
      "additionalProperties": false
    },
    "CaptureRequestMessage": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "capture.request"
        },
        "tab": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "t_target": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "v",
        "type",
        "tab",
        "t_target"
      ],
      "additionalProperties": false
    },
    "SessionDoneMessage": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "session.done"
        },
        "report_path": {
          "type": "string"
        },
        "issues": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "v",
        "type",
        "report_path",
        "issues"
      ],
      "additionalProperties": false
    },
    "ErrorMessage": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "error"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "v",
        "type",
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
