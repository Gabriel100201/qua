{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qua.local/schema/target-ref.schema.json",
  "$ref": "#/$defs/TargetRef",
  "$defs": {
    "TargetRef": {
      "type": "object",
      "properties": {
        "sel": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "$ref": "#/$defs/SelectorStrategy"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rect": {
          "$ref": "#/$defs/Rect"
        },
        "visible": {
          "type": "boolean"
        },
        "classes": {
          "type": "string"
        },
        "ancestorText": {
          "type": "string"
        },
        "computed": {
          "$ref": "#/$defs/ComputedStyle"
        },
        "component": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "src": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "sel",
        "strategy",
        "tag"
      ],
      "additionalProperties": false,
      "title": "TargetRef"
    },
    "SelectorStrategy": {
      "type": "string",
      "enum": [
        "testid",
        "id",
        "role-name",
        "css-path"
      ],
      "description": "Cascada de §5.2: primer match único gana."
    },
    "Rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "minimum": 0
        },
        "h": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false,
      "title": "Rect"
    },
    "ComputedStyle": {
      "type": "object",
      "properties": {
        "fontSize": {
          "type": "string"
        },
        "fontWeight": {
          "type": "string"
        },
        "padding": {
          "type": "string"
        },
        "margin": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "backgroundColor": {
          "type": "string"
        },
        "borderRadius": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "col": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "tier": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 3
            },
            {
              "type": "number",
              "const": 4
            }
          ]
        }
      },
      "required": [
        "file",
        "line",
        "tier"
      ],
      "additionalProperties": false
    }
  }
}
