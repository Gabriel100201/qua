{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qua.local/schema/utterance.schema.json",
  "$ref": "#/$defs/Utterance",
  "$defs": {
    "Utterance": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^u\\d{2,}$"
        },
        "t_start": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "t_end": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string"
        },
        "lang": {
          "type": "string",
          "minLength": 2
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Word"
          }
        },
        "avg_logprob": {
          "type": "number"
        },
        "no_speech_prob": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "marked": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "t_start",
        "t_end",
        "text",
        "lang",
        "words",
        "avg_logprob",
        "no_speech_prob",
        "marked"
      ],
      "additionalProperties": false,
      "title": "Utterance"
    },
    "Word": {
      "type": "object",
      "properties": {
        "w": {
          "type": "string"
        },
        "t": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "d": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "w",
        "t",
        "d",
        "p"
      ],
      "additionalProperties": false
    }
  }
}
