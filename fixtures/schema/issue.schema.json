{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qua.local/schema/issue.schema.json",
  "$ref": "#/$defs/Issue",
  "$defs": {
    "Issue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^i\\d{2,}$"
        },
        "utterance_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^u\\d{2,}$"
          }
        },
        "t": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "category": {
          "$ref": "#/$defs/IssueCategory"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "exported_to": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "utterance_ids",
        "t",
        "text",
        "anchor",
        "evidence",
        "category",
        "severity",
        "exported_to"
      ],
      "additionalProperties": false,
      "title": "Issue"
    },
    "Anchor": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/AnchorKind"
        },
        "target": {
          "$ref": "#/$defs/TargetRef"
        },
        "tab": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "url": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "confidence",
        "reason"
      ],
      "additionalProperties": false
    },
    "AnchorKind": {
      "type": "string",
      "enum": [
        "element",
        "route",
        "session"
      ],
      "description": "Las 3 clases de §07 paso 6. Regla de oro: ante duda, degradar a `route`."
    },
    "TargetRef": {
      "type": "object",
      "properties": {
        "sel": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "$ref": "#/$defs/SelectorStrategy"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rect": {
          "$ref": "#/$defs/Rect"
        },
        "visible": {
          "type": "boolean"
        },
        "classes": {
          "type": "string"
        },
        "ancestorText": {
          "type": "string"
        },
        "computed": {
          "$ref": "#/$defs/ComputedStyle"
        },
        "component": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "src": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "sel",
        "strategy",
        "tag"
      ],
      "additionalProperties": false,
      "title": "TargetRef"
    },
    "SelectorStrategy": {
      "type": "string",
      "enum": [
        "testid",
        "id",
        "role-name",
        "css-path"
      ],
      "description": "Cascada de §5.2: primer match único gana."
    },
    "Rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "minimum": 0
        },
        "h": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false,
      "title": "Rect"
    },
    "ComputedStyle": {
      "type": "object",
      "properties": {
        "fontSize": {
          "type": "string"
        },
        "fontWeight": {
          "type": "string"
        },
        "padding": {
          "type": "string"
        },
        "margin": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "backgroundColor": {
          "type": "string"
        },
        "borderRadius": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "col": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "tier": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 3
            },
            {
              "type": "number",
              "const": 4
            }
          ]
        }
      },
      "required": [
        "file",
        "line",
        "tier"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "console": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConsoleEvent"
          }
        },
        "net": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/NetFailEvent"
              },
              {
                "$ref": "#/$defs/NetSlowEvent"
              }
            ]
          }
        },
        "timings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Timing"
          }
        },
        "screenshot": {
          "type": "string"
        }
      },
      "required": [
        "console",
        "net",
        "timings"
      ],
      "additionalProperties": false
    },
    "ConsoleEvent": {
      "type": "object",
      "properties": {
        "t": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tab": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "k": {
          "type": "string",
          "const": "console"
        },
        "level": {
          "type": "string",
          "enum": [
            "error",
            "warn"
          ]
        },
        "text": {
          "type": "string"
        },
        "stack": {
          "type": "string"
        }
      },
      "required": [
        "t",
        "k",
        "level",
        "text"
      ],
      "additionalProperties": false
    },
    "NetFailEvent": {
      "type": "object",
      "properties": {
        "t": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tab": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "k": {
          "type": "string",
          "const": "net_fail"
        },
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "t",
        "k",
        "method",
        "url",
        "status",
        "duration_ms"
      ],
      "additionalProperties": false
    },
    "NetSlowEvent": {
      "type": "object",
      "properties": {
        "t": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tab": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "k": {
          "type": "string",
          "const": "net_slow"
        },
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "t",
        "k",
        "method",
        "url",
        "status",
        "duration_ms"
      ],
      "additionalProperties": false
    },
    "Timing": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "label",
        "ms"
      ],
      "additionalProperties": false
    },
    "IssueCategory": {
      "type": "string",
      "enum": [
        "ui",
        "bug",
        "perf",
        "copy",
        "idea"
      ],
      "description": "Precedencia de §07 paso 8: bug > perf > copy > ui > idea. Default: ui."
    },
    "Severity": {
      "type": "string",
      "enum": [
        "low",
        "med",
        "high"
      ]
    }
  }
}
