{
  "name": "@qua/extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Extensión Chrome MV3 (WXT). Modo local (D-L1-01): graba, transcribe y arma el reporte sin daemon.",
  "scripts": {
    "typecheck": "tsc --noEmit --pretty",
    "build:wasm": "PATH=$HOME/.cargo/bin:$PATH wasm-pack build ../crates/qua-wasm --target web --release --out-dir ../../extension/shared/qua-wasm --no-pack",
    "prebuild": "node scripts/copy-ort.mjs",
    "build": "wxt build",
    "test": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@huggingface/transformers": "3.8.1",
    "@qua/protocol": "workspace:*",
    "@qua/source-resolver": "workspace:*",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "@types/node": "^22.10.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  }
}
