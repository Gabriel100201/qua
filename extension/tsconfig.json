{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    // D-10 ya está arreglado en `packages/protocol` (su `exports` apunta a
    // `dist/src/`). Este alias se mantiene igual porque resuelve contra el
    // fuente TS y evita tener que construir el paquete antes de correr los
    // tests — es conveniencia, ya no un workaround.
    "paths": {
      "@qua/protocol": ["../packages/protocol/src/index.ts"]
    }
  },
  "include": ["entrypoints/**/*.ts", "test/**/*.ts"]
}
