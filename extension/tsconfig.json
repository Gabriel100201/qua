{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    // Resolvemos los paquetes del workspace contra su fuente TS en vez de contra
    // `dist/`. `dist/` está en .gitignore, así que depender de él obliga a construir
    // antes de testear y rompe en cualquier checkout limpio — que es justo lo que le
    // pasó a A3 (4 archivos de test sin poder cargar @qua/source-resolver).
    "paths": {
      "@qua/protocol": ["../packages/protocol/src/index.ts"],
      "@qua/source-resolver": ["../packages/source-resolver/src/index.ts"],
      // onnxruntime-web publica sus tipos fuera de "exports"; sin esto TS no los ve.
      "onnxruntime-web": ["node_modules/onnxruntime-web/types.d.ts"]
    }
  },
  "include": ["entrypoints/**/*.ts", "shared/**/*.ts", "test/**/*.ts"]
}
