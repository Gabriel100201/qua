{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QUA",
  "version": "0.1.0",
  "identifier": "app.qua.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "QUA",
        "url": "index.html#/onboarding",
        "width": 1040,
        "height": 700,
        "minWidth": 760,
        "minHeight": 480,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.qua/sessions/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/quad", "binaries/qua"],
    "resources": {
      "../../../extension/build/chrome-mv3": "extension"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "12.0"
    }
  }
}
