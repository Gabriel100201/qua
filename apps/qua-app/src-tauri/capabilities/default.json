{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacidades de la única ventana webview del app (§09): abrir la carpeta de una sesión en Finder, abrir la página grabada en el navegador y copiar el reporte.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/.qua" }, { "path": "$HOME/.qua/**" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    },
    "clipboard-manager:allow-write-text"
  ]
}
